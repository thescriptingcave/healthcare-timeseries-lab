# Healthcare Time-Series Lab — local environment configuration
# Copy to .env and adjust as needed. Do not commit .env.

# Kafka / Schema Registry
HTL_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
HTL_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_CLUSTER_ID=HYqe3TbqTS2kAR5_ClQe7g

# MinIO (S3-compatible object storage)
HTL_MINIO_ENDPOINT=localhost:9000
HTL_MINIO_ACCESS_KEY=minioadmin
HTL_MINIO_SECRET_KEY=minioadmin
HTL_MINIO_BUCKET=lake

# InfluxDB 2.x
HTL_INFLUX_URL=http://localhost:8086
HTL_INFLUX_ORG=healthcare
HTL_INFLUX_BUCKET=telemetry
HTL_INFLUX_TOKEN=htl_telemetry_admin_token_0011223344556677
INFLUX_ADMIN_PASSWORD=admin_password

# HAPI FHIR JPA
HTL_HAPI_BASE_URL=http://localhost:8080/fhir

# Trino
HTL_TRINO_URL=http://localhost:8082
HTL_TRINO_USER=trino

# Container-internal endpoints (used by docker-compose / service catalogs)
TRINO_MINIO_ENDPOINT=http://minio:9000